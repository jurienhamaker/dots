{
  "env": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:8787/w/claude",
    "_CLAUDE_CODE_ASSUME_FIRST_PARTY_BASE_URL": "1",
    "ENABLE_TOOL_SEARCH": "true",
    "ANTHROPIC_CUSTOM_MODEL_OPTION": "caveman-auto[1m]",
    "ANTHROPIC_CUSTOM_MODEL_OPTION_NAME": "Auto",
    "ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION": "Caveman pick model + effort each turn. Hard ask, big brain. Easy ask, save rocks.",
    "ANTHROPIC_CUSTOM_MODEL_OPTION_SUPPORTED_CAPABILITIES": "effort,max_effort,xhigh_effort,thinking,adaptive_thinking,interleaved_thinking"
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/jurien/.caveman/bin/caveman-proxy' native-hook claude --adapter '/home/jurien/.caveman/cli/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/usr/sbin/node'",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f '/home/jurien/.claude/skills/impeccable/scripts/impeccable' ] || '/home/jurien/.claude/skills/impeccable/scripts/impeccable' hook",
            "timeout": 5,
            "statusMessage": "Preparing build session"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/jurien/.caveman/bin/caveman-proxy' native-hook claude --adapter '/home/jurien/.caveman/cli/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/usr/sbin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/jurien/.caveman/bin/caveman-proxy' native-hook claude --adapter '/home/jurien/.caveman/cli/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/usr/sbin/node'",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/usr/sbin/node' '/home/jurien/.caveman/cli/bin/caveman' shrink-hook",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/jurien/.local/share/caveman-blocks/bin/caveman-blocks hook --harness claude",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/jurien/.caveman/bin/caveman-proxy' native-hook claude --adapter '/home/jurien/.caveman/cli/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/usr/sbin/node'",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f '/home/jurien/.claude/skills/impeccable/scripts/impeccable' ] || '/home/jurien/.claude/skills/impeccable/scripts/impeccable' hook",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/jurien/.caveman/bin/caveman-proxy' native-hook claude --adapter '/home/jurien/.caveman/cli/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/usr/sbin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/jurien/.caveman/bin/caveman-proxy' native-hook claude --adapter '/home/jurien/.caveman/cli/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/usr/sbin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/jurien/.caveman/bin/caveman-proxy' native-hook claude --adapter '/home/jurien/.caveman/cli/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/usr/sbin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/jurien/.caveman/bin/caveman-proxy' native-hook claude --adapter '/home/jurien/.caveman/cli/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/usr/sbin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/jurien/.caveman/bin/caveman-proxy' native-hook claude --adapter '/home/jurien/.caveman/cli/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/usr/sbin/node'",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f '/home/jurien/.claude/skills/impeccable/scripts/impeccable' ] || '/home/jurien/.claude/skills/impeccable/scripts/impeccable' hook",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/jurien/.caveman/bin/caveman-proxy' native-hook claude --adapter '/home/jurien/.caveman/cli/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/usr/sbin/node'",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "pstack@cursor-plugins": true,
    "ponytail@ponytail": true,
    "mattpocock-skills@claude-plugins-official": true,
    "hyperframes@hyperframes": true,
    "superpowers@claude-plugins-official": true,
    "statuspane@claude-statuspane": true,
    "ecc@ecc": true
  },
  "extraKnownMarketplaces": {
    "cursor-plugins": {
      "source": {
        "source": "github",
        "repo": "cursor/plugins"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "hyperframes": {
      "source": {
        "source": "github",
        "repo": "heygen-com/hyperframes"
      }
    },
    "claude-flightdeck": {
      "source": {
        "source": "github",
        "repo": "scasella/claude-flightdeck"
      }
    },
    "claude-statuspane": {
      "source": {
        "source": "github",
        "repo": "xuanji86/claude-statuspane"
      }
    },
    "ecc": {
      "source": {
        "source": "github",
        "repo": "affaan-m/everything-claude-code"
      }
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "description": "Impeccable design detector: immediate-tier checks after Edit/Write on UI files, full-rule deep pass on Stop."
}
